FROM python:3.14-slim
# Install system dependencies needed for compilation & tar compression
RUN apt-get update && apt-get install -y binutils tar && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
# Execute the shell script passing the version tag provided by the build argument
ARG TAG
RUN chmod +x create_executable.sh && ./create_executable.sh ${TAG}